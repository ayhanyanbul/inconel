{
  "name": "inconel",
  "version": "0.1.3",
  "description": "Accessible, type-safe React UI components for modern applications.",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "select",
    "input",
    "textarea",
    "typescript",
    "accessible"
  ],
  "author": "Ayhan Yanbul",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.lib.json --noEmit && vite build",
    "build:playground": "vite build --mode playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --outDir playground-dist",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "pack:check": "npm pack --dry-run --cache .npm-cache"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@tanstack/react-virtual": "^3.14.8",
    "@tinymce/tinymce-react": "^6.3.0",
    "@uiw/react-textarea-code-editor": "^3.1.1",
    "lodash": "^4.18.1",
    "prop-types": "^15.8.1",
    "react-datepicker": "^9.1.0",
    "react-imask": "^7.6.1",
    "react-select": "^5.10.2",
    "react-svg": "^17.2.4",
    "react-window": "^1.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.102.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  }
}
