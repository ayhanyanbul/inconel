{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/styles.d.ts",
    "src/legacy-jsx.d.ts",
    "src/index.ts",
    "src/adapters/**/*.ts",
    "src/adapters/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/playground"
  ]
}
