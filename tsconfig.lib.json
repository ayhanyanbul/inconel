{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/styles.d.ts",
    "src/index.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/playground"
  ]
}
